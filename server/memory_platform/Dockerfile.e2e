FROM kairos-web:native-test AS web
FROM kairos-test:native AS browser
USER root
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir playwright==1.55.0
COPY --from=web /usr/share/nginx/html /web
COPY --chown=postgres:postgres server/memory_platform /app/server/memory_platform
RUN mkdir /qa && chown postgres:postgres /qa
USER postgres

FROM browser AS handbook-test
RUN python -m memory_platform.tests.check_handbook

FROM browser AS checks
RUN python -m memory_platform.tests.e2e_portal
RUN python -m memory_platform.tests.check_handbook

FROM scratch AS evidence
COPY --from=checks /qa/ /

FROM checks AS test
