# Proxy HTTP hacia el Ollama instalado en WSL, con lista de permitidos.
#
# Ollama escucha en loopback dentro de WSL y, en ese modo, rechaza con 403
# cualquier peticion cuyo Host sea un nombre como `ollama`. Por eso se reescribe
# Host a localhost: los consumidores siguen usando http://ollama:11434.
#
# Solo llegan al upstream /api/embed (POST) y /api/version (GET). /api/chat llega
# unicamente si el operador pone OLLAMA_ALLOW_CHAT=1 (por defecto 0). Todo lo
# demas (pull, delete, create, generate, ...) recibe 403 desde este proxy y no
# llega al upstream. Cada ruta permitida es una coincidencia exacta y el
# proxy_pass lleva la ruta escrita: el upstream recibe siempre esa ruta, nunca la
# que mande el cliente (`//`, `/api/embed/../pull`, mayusculas, `%2e%2e`).
#
# La imagen oficial de nginx sustituye ${OLLAMA_UPSTREAM} y ${OLLAMA_ALLOW_CHAT}
# al arrancar; las dos las define docker-compose.yml. Una variable sin definir
# deja un `${...}` que nginx rechaza al cargar: el proxy no arranca (falla cerrado).

map "${OLLAMA_ALLOW_CHAT}" $kairos_chat_denied {
    default 1;
    "1"     0;
}

server {
    listen 11434;

    access_log off;
    client_max_body_size 0;

    proxy_http_version 1.1;
    proxy_set_header Host localhost;
    proxy_set_header Connection "";

    # Respuestas en streaming y generaciones largas con modelos grandes.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;

    location = /api/embed {
        limit_except POST { deny all; }
        proxy_pass http://${OLLAMA_UPSTREAM}/api/embed;
    }

    location = /api/version {
        limit_except GET { deny all; }
        proxy_pass http://${OLLAMA_UPSTREAM}/api/version;
    }

    location = /api/chat {
        if ($kairos_chat_denied) { return 403; }
        limit_except POST { deny all; }
        proxy_pass http://${OLLAMA_UPSTREAM}/api/chat;
    }

    location / {
        default_type text/plain;
        return 403 "Forbidden by the Kairos Ollama proxy\n";
    }
}
