FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS acquire
WORKDIR /out
RUN npm view @vscode/tree-sitter-wasm@0.3.1 version dist license --json > metadata.json && npm pack @vscode/tree-sitter-wasm@0.3.1 --ignore-scripts --json > pack.json
FROM scratch
COPY --from=acquire /out/ /
